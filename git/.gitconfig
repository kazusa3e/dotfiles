[core]
    quotepath = false                   # print filenames as-is instead of escaping non-ascii
    excludesfile = ~/.gitignore_global  # global gitignore patterns
    fsmonitor = true                    # watch filesystem changes to speed up git status
    untrackedCache = true               # cache untracked file lists for faster operations

[user]
    email = i@kazusa.me
    name = kazusa
    signingkey = 98822059682FE03381FA16F299F850C685650613

[commit]
    gpgsign = false

[status]
    submodulesummary = 1                # show submodule summary in status output

[init]
    defaultBranch = main                # default branch name for new repositories

[pull]
    rebase = true                       # rebase instead of merge on pull

[rebase]
    autostash = true                    # automatically stash/pop uncommitted changes
    autosquash = true                   # auto-move fixup commits during interactive rebase
    updateRefs = true                   # update dependent branches after rebase (git 2.41+)

[merge]
    conflictstyle = zdiff3              # show common ancestor in conflict markers

[push]
    autoSetupRemote = true              # auto-set upstream when pushing new branch
    default = simple                    # push only current branch to its upstream

[color]
    ui = auto                           # enable colored output when terminal supports it

[rerere]
    enabled = true                      # reuse recorded conflict resolutions

[fetch]
    prune = true                        # remove local refs to deleted remote branches
    pruneTags = true                    # remove local refs to deleted remote tags

[diff]
    algorithm = histogram               # produce more human-readable diffs
    colorMoved = dimmed-zebra           # highlight moved lines instead of delete/add
    submodule = log                     # show detailed log for submodule changes
    renames = copies                    # detect copies in addition to renames

[branch]
    sort = -committerdate               # sort branches by most recent commit date

[tag]
    sort = -version:refname             # sort tags by semantic version number

[help]
    autocorrect = prompt                # prompt before running autocorrected command

[column]
    ui = auto                           # auto-format branch/tag output into columns
