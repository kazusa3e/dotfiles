#!/usr/bin/env bash
# Use native macOS tools and sysstat on Linux. Stowed as ~/.tmux/tmux-status.
set -eu

rate() {
  awk -v kib="$1" 'BEGIN {
    bytes = kib * 1024
    mib = bytes / 1048576
    gib = bytes / 1073741824
    if (bytes < 1024) value = sprintf("%.0fB/s", bytes)
    else if (bytes < 1048576) value = sprintf("%dKB/s", int(bytes / 1024))
    else if (mib < 100) value = sprintf("%.1fMB/s", mib)
    else if (mib < 1024) value = sprintf("%dMB/s", int(mib))
    else if (gib < 100) value = sprintf("%.1fGB/s", gib)
    else value = sprintf("%dGB/s", int(gib))
    printf "%7s", value
  }'
}

case "$(uname -s)" in
  Darwin)
    sample=$(LC_ALL=C top -l 2 -s 1 -n 0 2>/dev/null) || exit 0
    total_memory=$(sysctl -n hw.memsize 2>/dev/null) || exit 0
    memory_sample=$(LC_ALL=C vm_stat 2>/dev/null) || exit 0
    cpu_pct=$(awk '
      /CPU usage:/ { used = 100 - $(NF - 1); found = 1 }
      END { if (found) printf "%.0f", used }
    ' <<<"$sample")
    # Active, wired and compressed pages exclude reclaimable inactive pages.
    memory_pct=$(awk -F ': *' -v total="$total_memory" '
      /page size of/ {
        page_size = $0
        sub(/.*page size of /, "", page_size)
        page_size += 0
      }
      $1 == "Pages active" { active = $2 + 0 }
      $1 == "Pages wired down" { wired = $2 + 0 }
      $1 == "Pages occupied by compressor" { compressed = $2 + 0 }
      END {
        if (page_size > 0 && total > 0)
          printf "%.0f", (active + wired + compressed) * page_size * 100 / total
      }
    ' <<<"$memory_sample")
    [[ -n "$cpu_pct" && -n "$memory_pct" ]] || exit 0

    interface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
    network_counters() {
      netstat -ib 2>/dev/null | awk -v interface="$interface" '
        $1 == interface { rx += $7; tx += $10 }
        END { printf "%.0f %.0f\n", rx + 0, tx + 0 }
      '
    }
    disk_counters() {
      local kind value decimal
      local disk_read_bytes=0
      local disk_written_bytes=0
      while read -r kind value; do
        value=${value%,}
        decimal=$(printf '%d' "$value" 2>/dev/null) || decimal=0
        if [[ "$kind" == read ]]; then
          disk_read_bytes=$((disk_read_bytes + decimal))
        else
          disk_written_bytes=$((disk_written_bytes + decimal))
        fi
      done < <(ioreg -r -c IOBlockStorageDriver -w 0 2>/dev/null | awk '
        /"Bytes \(Read\)"[[:space:]]*=/ { print "read", $NF }
        /"Bytes \(Write\)"[[:space:]]*=/ { print "write", $NF }
      ')
      printf '%s %s\n' "$disk_read_bytes" "$disk_written_bytes"
    }

    read -r net_before_in net_before_out <<<"$(network_counters)"
    read -r disk_before_read disk_before_written <<<"$(disk_counters)"
    sleep 1
    read -r net_after_in net_after_out <<<"$(network_counters)"
    read -r disk_after_read disk_after_written <<<"$(disk_counters)"
    net_read=$(awk -v before="$net_before_in" -v after="$net_after_in" '
      BEGIN { delta = after - before; if (delta < 0) delta = 0; printf "%.3f", delta / 1024 }
    ')
    net_written=$(awk -v before="$net_before_out" -v after="$net_after_out" '
      BEGIN { delta = after - before; if (delta < 0) delta = 0; printf "%.3f", delta / 1024 }
    ')
    disk_read=$(awk -v before="$disk_before_read" -v after="$disk_after_read" '
      BEGIN { delta = after - before; if (delta < 0) delta = 0; printf "%.3f", delta / 1024 }
    ')
    disk_written=$(awk -v before="$disk_before_written" -v after="$disk_after_written" '
      BEGIN { delta = after - before; if (delta < 0) delta = 0; printf "%.3f", delta / 1024 }
    ')

    cpu_color='#f9e2af'
    memory_color='#cba6f7'
    network_color='#89dceb'
    disk_color='#fab387'
    (( $(awk -v read="$net_read" -v written="$net_written" 'BEGIN { print (read >= 1024 || written >= 1024) ? 1 : 0 }') )) && network_color='#f38ba8'
    (( $(awk -v read="$disk_read" -v written="$disk_written" 'BEGIN { print (read >= 1024 || written >= 1024) ? 1 : 0 }') )) && disk_color='#f38ba8'
    (( cpu_pct >= 80 )) && cpu_color='#f38ba8'
    (( memory_pct >= 80 )) && memory_color='#f38ba8'
    printf '#[fg=%s,bold]󰈀#[nobold] %s↓ %s↑#[fg=#6c7086] │ #[fg=%s,bold]󰻠#[nobold]%4s#[fg=#6c7086] │ #[fg=%s,bold]󰋊#[nobold] R%s W%s#[fg=#6c7086] │ #[fg=%s,bold]󰍛#[nobold]%4s' \
      "$network_color" \
      "$(rate "$net_read")" \
      "$(rate "$net_written")" \
      "$cpu_color" \
      "$(printf '%3s%%' "$cpu_pct")" \
      "$disk_color" \
      "$(rate "$disk_read")" \
      "$(rate "$disk_written")" \
      "$memory_color" \
      "$(printf '%3s%%' "$memory_pct")"
    exit 0
    ;;
  Linux)
    for dependency in ip iostat sar; do
      command -v "$dependency" >/dev/null 2>&1 || exit 0
    done
    ;;
  *) exit 0 ;;
esac

interface=$(ip route show default | awk 'NR == 1 { print $5 }')
sample_file=$(mktemp -t tmux-status.XXXXXX)
network_file=$(mktemp -t tmux-status.XXXXXX)
trap 'rm -f "$sample_file" "$network_file"' EXIT
LC_ALL=C iostat -cdxk -y 1 1 >"$sample_file" &
iostat_pid=$!
LC_ALL=C sar -n DEV 1 1 >"$network_file" &
sar_pid=$!

wait "$iostat_pid"
wait "$sar_pid"
sample=$(<"$sample_file")

disk_sparklines() {
  awk '
    {
      read_rate[++count] = $2
      write_rate[count] = $3
      if ($2 > maximum) maximum = $2
      if ($3 > maximum) maximum = $3
    }
    END {
      glyph[0] = "⣀"; glyph[1] = "⣄"; glyph[2] = "⣤"; glyph[3] = "⣦"
      glyph[4] = "⣶"; glyph[5] = "⣷"; glyph[6] = "⣾"; glyph[7] = "⣿"
      for (position = count + 1; position <= 6; position++) read_plot = read_plot "·"
      for (position = 1; position <= count; position++) {
        level = maximum > 0 ? int(read_rate[position] * 7 / maximum + 0.5) : 0
        read_plot = read_plot glyph[level]
      }
      for (position = count + 1; position <= 6; position++) write_plot = write_plot "·"
      for (position = 1; position <= count; position++) {
        level = maximum > 0 ? int(write_rate[position] * 7 / maximum + 0.5) : 0
        write_plot = write_plot glyph[level]
      }
      print read_plot, write_plot
    }
  '
}

cpu_pct=$(awk '/^avg-cpu:/ { getline; printf "%.0f", 100 - $NF }' <<<"$sample")
cpu=$(printf '%3s%%' "$cpu_pct")
memory_pct=$(awk '/MemTotal:/ { total = $2 } /MemAvailable:/ { available = $2 } END { printf "%.0f", (total - available) * 100 / total }' /proc/meminfo)
memory=$(printf '%3s%%' "$memory_pct")
read -r disk_util disk_read disk_written < <(awk '
  $1 ~ /^Device/ {
    devices = 1
    for (column = 1; column <= NF; column++) {
      if ($column == "kB_read/s" || $column == "rkB/s") read_column = column
      if ($column == "kB_wrtn/s" || $column == "wkB/s") written_column = column
      if ($column == "%util") util_column = column
    }
    next
  }
  devices && $1 ~ /^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+)$/ {
    read_kib += $(read_column)
    written_kib += $(written_column)
    if ($(util_column) > max_util) max_util = $(util_column)
  }
  END {
    printf "%.0f%% %.3f %.3f\n", max_util, read_kib, written_kib
  }
' <<<"$sample")

read -r net_read net_written < <(awk -v interface="$interface" '
  $1 == "Average:" && $2 == interface { print $5, $6; found = 1 }
  END { if (!found) print 0, 0 }
' "$network_file")

state_dir=${XDG_RUNTIME_DIR:-/tmp}
[[ -d "$state_dir" && -w "$state_dir" ]] || state_dir=/tmp
state_file="$state_dir/tmux-status-disk-${UID}"
now=$(date +%s)
last_sample=$(awk 'NF == 3 { timestamp = $1 } END { print timestamp }' "$state_file" 2>/dev/null || true)
if [[ -z "$last_sample" || "$((now - last_sample))" -ge 10 ]]; then
  state_temp=$(mktemp "${state_file}.XXXXXX")
  {
    [[ -f "$state_file" ]] && awk 'NF == 3' "$state_file" | tail -n 5
    printf '%s %s %s\n' "$now" "$disk_read" "$disk_written"
  } >"$state_temp"
  mv "$state_temp" "$state_file"
fi
read -r read_sparkline write_sparkline < <(disk_sparklines <"$state_file")

network_color='#89dceb'
cpu_color='#f9e2af'
disk_color='#fab387'
memory_color='#cba6f7'
(( $(awk -v read="$net_read" -v written="$net_written" 'BEGIN { print (read >= 1024 || written >= 1024) ? 1 : 0 }') )) && network_color='#f38ba8'
(( cpu_pct >= 80 )) && cpu_color='#f38ba8'
disk_pct=${disk_util%\%}
(( disk_pct >= 80 )) && disk_color='#f38ba8'
(( memory_pct >= 80 )) && memory_color='#f38ba8'

printf '#[fg=%s,bold]󰈀#[nobold] %s↓ %s↑#[fg=#6c7086] │ #[fg=%s,bold]󰻠#[nobold]%4s#[fg=#6c7086] │ #[fg=%s,bold]󰋊#[nobold]%4s R%s W%s#[fg=#6c7086] │ #[fg=%s,bold]󰍛#[nobold]%4s' \
  "$network_color" \
  "$(rate "$net_read")" \
  "$(rate "$net_written")" \
  "$cpu_color" \
  "$cpu" \
  "$disk_color" \
  "$disk_util" \
  "$read_sparkline" \
  "$write_sparkline" \
  "$memory_color" \
  "$memory"
