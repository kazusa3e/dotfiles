#!/usr/bin/env python3

import os
import sys
from datetime import date, timedelta
from pathlib import Path

DEFAULT_DUE_DAYS = 15


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: todo <flash>")
        print("write into $WIKI_DIR/Inbox.md")
        return 0

    text = " ".join(argv).strip()
    if not text:
        print("todo: empty text", file=sys.stderr)
        return 2

    wiki_dir = os.environ.get("WIKI_DIR")
    if not wiki_dir:
        print("todo: WIKI_DIR is not set", file=sys.stderr)
        return 2

    inbox = Path(wiki_dir).expanduser() / "Inbox.md"
    if not inbox.parent.is_dir():
        print(f"todo: vault directory not found: {inbox.parent}", file=sys.stderr)
        return 2

    status = "?" if text.endswith(("?", "？")) else " "
    due = (date.today() + timedelta(days=DEFAULT_DUE_DAYS)).isoformat()
    line = f"- [{status}] #task/flash {text} 📅 {due}\n"

    try:
        if not inbox.exists() or inbox.stat().st_size == 0:
            inbox.write_text("# Inbox\n\n", encoding="utf-8")
        with inbox.open("a", encoding="utf-8") as f:
            f.write(line)
    except OSError as error:
        print(f"todo: {error}", file=sys.stderr)
        return 1

    print(f"written: {text}, due: {due}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
