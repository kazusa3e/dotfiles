{
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-cc-extensions",
      "themes": [
        "-themes/cc-dark.json",
        "-themes/cc-light.json"
      ]
    },
    "npm:@llblab/pi-codex-usage"
  ],
  "theme": "soft-indigo",
  "enableSkillCommands": true,
  "enableInstallTelemetry": false,
  "steeringMode": "all",
  "treeFilterMode": "no-tools",
  "compaction": {
    "enabled": false
  },
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "cacheWarming": "idle",
  "markdown": {
    "mermaid": "final"
  },
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "hidden",
  "fullscreenWheelScrollLines": 10,
  "defaultTools": [
    "+codemode"
  ]
}
