# ls
alias l="eza --classify --reverse --sort=modified"
alias ll="eza --classify --all --long --reverse --sort=modified"

# git
alias gl="git log --color --graph --pretty=format:'%Cred%h%Creset - %s%C(yellow)%d%Creset %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gla="gl --all"
alias gs="git status -sb"
alias gb="git branch"
alias gd="git diff"
alias gdp="git diff HEAD^"
alias gds="git diff --staged"
alias gco="git checkout"
alias gaa="git add -A"
alias gph="git push"
alias gpl="git pull"
alias gcn="git clean -fd && git reset --hard HEAD"
alias gg="lazygit"

# tmux
function t () {
    p=${PWD##*/}

    if [[ -z "$1" ]]; then
        tmux attach -t $p || tmux new-session -s $p
    else
        tmux attach -t "$1" || tmux new-session -s "$1"
    fi
}

# pi-coding-agent
function pid () {
    local docker="podman"
    local image_name="pid"
    local -a docker_args=() pi_args=()
    local mount_cwd=0
    local after_ddash=0

    for arg in "$@"; do
        if [[ "$after_ddash" -eq 0 ]] && [[ "$arg" == "--cwd" ]]; then
            mount_cwd=1
            continue
        fi
        if [[ "$after_ddash" -eq 0 ]] && [[ "$arg" == "--" ]]; then
            after_ddash=1
            continue
        fi
        if [[ "$after_ddash" -eq 1 ]]; then
            pi_args+=("$arg")
        else
            docker_args+=("$arg")
        fi
    done

    docker_args=(
        --rm -it
        --userns=keep-id
        # --network=host
        -e HOME="$HOME"
        -v "$HOME/.pi:$HOME/.pi"
        "${docker_args[@]}"
    )

    if [[ "$mount_cwd" -eq 1 ]]; then
        docker_args+=(-v "$PWD:$PWD" --workdir "$PWD")
    else
        docker_args+=(--workdir "/workspace")
    fi

    ${docker} run "${docker_args[@]}" ${image_name} "${pi_args[@]}"
}

alias mk="make -f cmd.mk"

# vim: ft=zsh
